# Stored at op://homelab/games-cloud-game/values.local.yaml (see the secrets
# CLI). Same read-only NAS user RomM uses is fine.

smb:
  username: "roms-reader"
  password: "CHANGE-ME"

# Long-term credential for coturn on the egress VPS, matching the `user=` line
# in /etc/turnserver.conf there (infra/egress-proxy/vps, TURN_RELAY=true).
# Only needed while an entry in webrtc.iceServers sets credentialSecret.
turn:
  credential: "CHANGE-ME"
