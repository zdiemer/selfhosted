# Local Helm state
charts/
Chart.lock
*.tgz

# Editor / OS cruft
.DS_Store
.vscode/
.idea/
*.swp
*~

# Secrets — never commit. Use kubectl create secret or sealed-secrets instead.
*-secret.yaml
*.secret.yaml
secrets/

# ...but a chart's templates/ directory is Helm source, never a rendered
# manifest. A file there named <thing>-secret.yaml holds .Values references and
# nothing else, and the chart cannot render without it. The rule above had
# silently excluded three such templates (auth/keepass x2, docs/paperless-ngx):
# they existed on one laptop, git status never mentioned them, and a fresh
# clone could not deploy those charts — the same single-copy failure that
# scripts/secrets.sh exists to prevent, wearing a different hat.
!**/templates/*-secret.yaml

# Local-only overlays (per-project secrets: tokens, passwords, identities).
# The ** glob covers every subproject's values.local.yaml.
**/values.local.yaml

# .claude/settings.local.json is this machine's permission grants and stays
# local. settings.json is the opposite: the submodule deny rules belong to the
# repo, so they reach every checkout and the claude-workspace pod.
#
# `.claude/*` and not `.claude/`: git cannot re-include a file whose parent
# DIRECTORY is excluded — it never descends far enough to see the negation — so
# the trailing-slash form would make the next line dead.
.claude/*
!.claude/settings.json

# apartment-watch search stipulations — carries the alert phone number and a
# personal shortlist of where to live. criteria.example.yaml is the tracked
# template; the real one stays local, same shape as values.local.yaml.
web/apartment-watch/criteria.yaml
web/apartment-watch/.venv/

# Gradle build artifacts (claude-mod). The JAR is sideloaded via install.sh,
# not checked in.
**/build/
**/.gradle/

# Claude-mod compileOnly jar cache, populated from the live mc pod by
# install.sh's prep_libs() — never committed.
minecraft/claude-mod/libs/

# Python __pycache__
__pycache__/
*.pyc

# Egress audit captures (scripts/egress-audit.sh). Raw DNS query logs plus pod
# IP snapshots — a full record of everything the cluster resolved during the
# window, so it stays local.
.egress-audit/

# Generated by scripts/build-secrets-cli.sh — rebuilt, never edited.
dist/
