# Confirm every secret this fleet deploys is still resolvable from 1Password.
#
# REPLACES selfhosted-secrets-sync.service, which reconciled the vault against a
# values.local.yaml on disk. There are no such files any more: every upgrade.sh
# resolves its secrets into memory at deploy time (scripts/lib/secret-values.sh),
# so there is no second copy that can drift and nothing left to reconcile.
#
# What can still go wrong is quieter, and this is the unit that catches it: a
# vault item renamed or deleted, a field emptied, a template pointing at an
# op:// path that no longer resolves. None of that shows up until the next
# deploy, where it surfaces as a chart rendering a Secret with a blank value —
# which installs perfectly and fails at runtime. `check` asserts every reference
# resolves AND is non-empty, so the failure arrives here instead, on a schedule,
# with an SMS attached.
#
# Exits non-zero when anything does not resolve, which is what makes OnFailure
# meaningful.
#
# Install (see also scripts/systemd/README.md):
#     ln -sf ~/Code/selfhosted/scripts/systemd/selfhosted-secrets-check.{service,timer} ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now selfhosted-secrets-check.timer

[Unit]
Description=Check every selfhosted secret still resolves from 1Password
Documentation=file:%h/Code/selfhosted/scripts/secrets.sh
After=network-online.target
Wants=network-online.target
OnFailure=selfhosted-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/Code/selfhosted
ExecStart=%h/Code/selfhosted/scripts/secrets.sh check

Nice=10
IOSchedulingClass=idle
TimeoutStartSec=20min

# ProtectHome=read-only is now accurate rather than aspirational: this unit has
# no reason to write anything into the checkout, because nothing is materialized
# any more. The two op paths remain, and are easy to miss — `systemd-run` with no
# hardening works fine and this unit then fails:
#   %t            op starts a background daemon and writes op-daemon.pid there;
#                 it is also where the session token is cached (tmpfs, per-user,
#                 gone at logout).
#   ~/.config/op  op rewrites its own config on sign-in (latest_signin, device
#                 registration) and errors out if it cannot.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/op %t
NoNewPrivileges=true

[Install]
WantedBy=default.target
