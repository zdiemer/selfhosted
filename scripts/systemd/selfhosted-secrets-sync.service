# Keep 1Password and every values.local.yaml converged, without being asked.
#
# This is the unit that removes the churn. Before it, a secret changed in
# ~/Code/money reached the vault only if someone remembered to run
# `secrets.sh push`, and a secret changed in the vault reached disk only on a
# `pull` — which is strictly more work than the gitignored files this replaced.
#
# It runs unattended because scripts/op-session.sh can now obtain a session
# without a terminal (see scripts/lib/op-signin-pty.py). That same capability is
# why the backup unit no longer needs --files-only.
#
# CONSERVATIVE BY CONSTRUCTION. `sync` pushes only when the file moved and the
# vault did not, pulls only in the reverse case, and refuses when both moved —
# judged against a recorded hash of what the two sides last agreed on, not
# against mtimes. It exits non-zero on anything it declined to decide, which is
# what makes OnFailure below meaningful.
#
# Install (see also scripts/systemd/README.md):
#     ln -sf ~/Code/selfhosted/scripts/systemd/selfhosted-secrets-sync.{service,timer} ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now selfhosted-secrets-sync.timer

[Unit]
Description=Reconcile selfhosted secrets with 1Password
Documentation=file:%h/Code/selfhosted/scripts/secrets.sh
After=network-online.target
Wants=network-online.target
OnFailure=selfhosted-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/Code/selfhosted
ExecStart=%h/Code/selfhosted/scripts/secrets.sh sync

# --yes is deliberate: the paper-key prompt in `backup` is interactive and fires
# on first use only. A timer must never reach it, and an explicit error is far
# better than a run that hangs forever holding a session.
Environment=KEEP=20

Nice=10
IOSchedulingClass=idle
TimeoutStartSec=20min

# Writes to: the checkout, the standalone clones under ~/Code, the sync markers,
# and two places op insists on. ReadWritePaths overrides both ProtectSystem and
# ProtectHome for exactly these.
#
# The op paths are not optional and are easy to miss, because `systemd-run` with
# no hardening works fine and this unit then fails:
#   %t            op starts a background daemon and writes op-daemon.pid there;
#                 it is also where the session token is cached (tmpfs, per-user,
#                 gone at logout).
#   ~/.config/op  op rewrites its own config on sign-in (latest_signin, device
#                 registration) and errors out if it cannot.
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/selfhosted %h/.config/op %h/Code %t
NoNewPrivileges=true

[Install]
WantedBy=default.target
