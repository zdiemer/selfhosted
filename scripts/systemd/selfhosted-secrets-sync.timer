# Every 15 minutes. Frequent enough that "edit the file and forget about it"
# behaves the way the old gitignored files did, and cheap enough not to matter:
# a quiet run is one `op inject` per managed file (~24) and no writes.
#
# Persistent=true so a laptop that was asleep reconciles on wake rather than
# waiting for the next quarter hour.

[Unit]
Description=Reconcile selfhosted secrets with 1Password every 15 minutes
Documentation=file:%h/Code/selfhosted/scripts/systemd/README.md

[Timer]
# OnCalendar, NOT OnBootSec + OnUnitActiveSec. Those two are both MONOTONIC, and
# together they leave a window where the timer schedules nothing at all: if the
# user manager restarts long after boot, OnBootSec is already in the past, and
# OnUnitActiveSec has no anchor because this timer instance has not activated the
# service yet. systemd reports the timer as `active (elapsed)` with
# `Trigger: n/a` and NextElapseUSecMonotonic=infinity, and it never fires again.
#
# Found 2026-08-13: dead since 2026-08-10 18:23, when the user manager restarted
# 9 minutes after the last run. Two days of no reconciliation, and OnFailure=
# could not catch it — a timer that never fires never fails. Nothing else noticed
# because ~/.config/selfhosted/alert.env did not exist either.
#
# The old comment here said "Not OnBootSec=0: at login the network is usually not
# up yet, and the first run would fail into an SMS for no reason." That concern is
# real but belongs to the service, which already has Wants/After=
# network-online.target; it does not need to be bought with a monotonic timer.
OnCalendar=*:0/15
AccuracySec=1min
# Now meaningful: Persistent= only applies to OnCalendar=. A laptop that was
# asleep across a scheduled run reconciles on wake instead of waiting.
Persistent=true
Unit=selfhosted-secrets-sync.service

[Install]
WantedBy=timers.target
