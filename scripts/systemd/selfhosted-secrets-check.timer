# Every 15 minutes, the same cadence the sync timer ran at. A check is cheaper
# than a sync was — one `op inject` per template and no writes at all — and the
# thing it guards against (a vault field emptied or renamed) is silent until a
# deploy, so finding out within the quarter hour is worth the calls.
#
# OnCalendar, NOT OnBootSec + OnUnitActiveSec. Those are both monotonic, and
# together they leave a window where nothing is scheduled: if the user manager
# restarts long after boot, OnBootSec is already in the past and OnUnitActiveSec
# has no anchor because this timer instance has not activated the service yet.
# systemd then reports `active (elapsed)` with Trigger: n/a and
# NextElapseUSecMonotonic=infinity, and it never fires again. That is exactly how
# the sync timer died on 2026-08-10 and went unnoticed for three days — OnFailure
# cannot catch it, because a timer that never fires never fails.

[Unit]
Description=Check selfhosted secrets against 1Password every 15 minutes
Documentation=file:%h/Code/selfhosted/scripts/systemd/README.md

[Timer]
OnCalendar=*:0/15
AccuracySec=1min
# Only meaningful with OnCalendar=. A laptop asleep across a scheduled run
# checks on wake instead of waiting for the next quarter hour.
Persistent=true
Unit=selfhosted-secrets-check.service

[Install]
WantedBy=timers.target
