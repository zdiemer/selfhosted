# Weekly age-encrypted backup of every values.local.yaml to the NAS.
#
# A USER unit, not a system one: the age key, the NAS credentials and the
# 1Password session all live under ~/.config/selfhosted, and running as root
# would need copies of all three somewhere else.
#
# Install (see also scripts/systemd/README.md):
#     mkdir -p ~/.config/systemd/user
#     ln -sf ~/Code/selfhosted/scripts/systemd/selfhosted-secrets-backup.{service,timer} ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now selfhosted-secrets-backup.timer
#     loginctl enable-linger "$USER"     # REQUIRED — see below
#
# `loginctl enable-linger` is not optional. Without it systemd tears down the
# user manager at logout, and the timer simply never fires — silently, which is
# the one failure mode a backup must not have.

[Unit]
Description=Back up selfhosted secrets to the NAS (age-encrypted)
Documentation=file:%h/Code/selfhosted/scripts/secrets.sh
# No point starting if the NAS is unreachable; the run would just fail.
After=network-online.target
Wants=network-online.target
OnFailure=selfhosted-alert@%n.service

[Service]
Type=oneshot
WorkingDirectory=%h/Code/selfhosted

# This used to be `backup --files-only`, because the vault dump needs a live
# `op` session and an unattended run could never have one — tokens expire after
# 30 minutes of inactivity, and Service Accounts are a Teams feature this
# account does not have. So the weekly archive silently shipped without the one
# piece that lets you rebuild 1Password itself.
#
# scripts/op-session.sh removed that constraint: it signs in through a pty
# (scripts/lib/op-signin-pty.py) using the password at
# ~/.config/selfhosted/op-password. The full archive is back, and a failure now
# means something is genuinely wrong rather than being the expected weekly noise
# — which is why OnFailure above is worth having.
#
# If that password file is not set up, this fails loudly instead of degrading
# quietly. Either fix it, or put --files-only back on this line deliberately.
ExecStart=%h/Code/selfhosted/scripts/secrets.sh backup

# The paper-key prompt only fires on first use and is interactive; a timer must
# never hit it. --yes makes that an explicit error rather than a hang.
Environment=KEEP=20

Nice=10
IOSchedulingClass=idle
TimeoutStartSec=15min

# The script writes to /dev/shm, ~/.config/selfhosted and the NAS — plus, now
# that it takes a real vault dump, the two paths op requires: %t for its daemon
# pidfile and the cached session token, and ~/.config/op for the config it
# rewrites on sign-in. Without those it fails with a read-only filesystem error
# that looks nothing like an authentication problem.
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/.config/selfhosted %h/.config/op %t
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=default.target
