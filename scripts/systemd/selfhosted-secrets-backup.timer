# Weekly trigger for selfhosted-secrets-backup.service.
#
# Weekly rather than daily because the content barely moves: `secrets.sh push`
# already runs a backup after every change, so this timer is the safety net for
# secrets that changed some other way (a chart's upgrade.sh generating a
# password, a hand edit), not the primary path.

[Unit]
Description=Weekly selfhosted secrets backup to the NAS
Documentation=file:%h/Code/selfhosted/scripts/secrets.sh

[Timer]
OnCalendar=Sun 03:00
# The devbox is not always on at 03:00 on a Sunday. Without this the run is
# simply skipped and the backup silently ages; with it, the run happens at the
# next opportunity.
Persistent=true
# Avoid hammering the NAS at exactly the same second as anything else.
RandomizedDelaySec=30min
AccuracySec=1min

[Install]
WantedBy=timers.target
