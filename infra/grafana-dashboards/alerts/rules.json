[
  {
    "uid": "sh-node-notready",
    "title": "Node not Ready",
    "condition": "C",
    "ruleGroup": "selfhosted",
    "for": "10m",
    "isPaused": false,
    "noDataState": "NoData",
    "execErrState": "Error",
    "labels": {
      "severity": "critical",
      "cluster": "home-k3s"
    },
    "annotations": {
      "summary": "A node has been NotReady for 10 minutes. Everything on it has been rescheduled or is stranded."
    },
    "notification_settings": {
      "receiver": "unwired"
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__PROM_UID__",
        "model": {
          "refId": "A",
          "expr": "sum(kube_node_status_condition{cluster=\"home-k3s\", condition=\"Ready\", status=\"true\"}) < 9",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "intervalMs": 60000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  0
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "C"
                ]
              },
              "reducer": {
                "params": [],
                "type": "last"
              },
              "type": "query"
            }
          ]
        }
      }
    ]
  },
  {
    "uid": "sh-node-disk",
    "title": "Node root filesystem above 85%",
    "condition": "C",
    "ruleGroup": "selfhosted",
    "for": "15m",
    "isPaused": false,
    "noDataState": "NoData",
    "execErrState": "Error",
    "labels": {
      "severity": "critical",
      "cluster": "home-k3s"
    },
    "annotations": {
      "summary": "A node is running out of root disk. This is the most common way this cluster falls over."
    },
    "notification_settings": {
      "receiver": "unwired"
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__PROM_UID__",
        "model": {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{cluster=\"home-k3s\", mountpoint=\"/\"} / node_filesystem_size_bytes{cluster=\"home-k3s\", mountpoint=\"/\"})",
          "instant": true,
          "range": false,
          "editorMode": "code",
          "intervalMs": 60000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "C",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "C",
          "type": "threshold",
          "datasource": {
            "type": "__expr__",
            "uid": "__expr__"
          },
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "params": [
                  85
                ],
                "type": "gt"
              },
              "operator": {
                "type": "and"
              },
              "query": {
                "params": [
                  "C"
                ]
              },
