# Minecraft relay: public :25565 on this box → tailnet → any cluster node.
# Installed by bootstrap.sh when MC_RELAY=true; @SSH-substituted values none —
# edit the server list here, in git, and re-run bootstrap to apply.
#
# WHY THIS EXISTS. The home router no longer forwards any port, and
# zachd.duckdns.org resolves to a tailnet address the public internet can't
# route. Friends connect to minecraft.diemer.codes (a DNS-only record on this
# VPS — Cloudflare can't proxy raw TCP on the free plan), and this haproxy
# carries the connection over WireGuard to the cluster. The home IP never
# appears anywhere public.
#
# The mc-minecraft Service is externalTrafficPolicy: Cluster, so EVERY node's
# :25565 forwards to the pod wherever it currently runs — the server list below
# needs no updating when the pod moves. `balance first` keeps all traffic on
# the first reachable node instead of spraying connections.
#
# NO HEALTH CHECKS, DELIBERATELY. The server autopauses when idle, and wakes on
# any TCP connection — a periodic probe looks exactly like a player joining,
# so `check` here would mean the JVM never sleeps again. The cost: haproxy
# only discovers a dead node when a real connection fails, eating a few
# seconds of `retries` + `option redispatch` before landing on a live one.
# Rare (a node down) and cheap (one slow join), so the trade goes this way.

global
  log /dev/log local0
  maxconn 512

defaults
  mode tcp
  log global
  option tcplog
  timeout connect 3s
  # Minecraft sessions are long-lived idle-ish TCP; anything short here kicks
  # players mid-game.
  timeout client 4h
  timeout server 4h
  retries 3
  option redispatch

frontend minecraft
  bind :25565

  # ---------------------------------------------------------------------
  # Per-source connection limiting
  # ---------------------------------------------------------------------
  # The nftables meter in front of this box is a packet-rate floor and knows
  # nothing about connections; this knows how many a source currently HOLDS,
  # which is the thing that actually exhausts a relay. `maxconn 512` above is
  # global, so without this one source can take all 512 and lock every real
  # player out — a denial of service that costs the attacker one cheap host and
  # never reaches the Minecraft whitelist, because the whitelist lives on the
  # far side of a connection that was never established.
  #
  # The table keys on source IP: 100k entries, expiring 10 minutes after a
  # source goes quiet. ~10 MB, which on this box is affordable and bounded.
  stick-table type ip size 100k expire 10m store conn_cur,conn_rate(60s)
  tcp-request connection track-sc0 src

  # 8 concurrent from one address. A player uses one connection, plus a
  # transient second when the server-list ping and a join overlap; a household
  # sharing a WAN address with four players sits at four or five. 8 is roomy
  # for anyone real and ruinous for a connection flood.
  tcp-request connection reject if { sc0_conn_cur ge 8 }

  # 30 new connections per minute from one address. Deliberately the same
  # number as the nftables meter — they are not redundant, they are the same
  # policy stated at two layers, and a source that slips past the packet meter
  # (fragmented, or arriving while the meter entry has aged out) still meets it
  # here. Keep the two in step if either is retuned.
  tcp-request connection reject if { sc0_conn_rate ge 30 }

  # NOTE ON WHAT THIS CANNOT DO. Both rules key on source IP, so they shape
  # single-source abuse and do nothing about a distributed flood — for that the
  # answer is the provider's own DDoS protection, which is upstream of this box
  # and not configurable from here. This is the layer that stops one bored
  # person with a VPS, which is the realistic threat to a friends' Minecraft
  # server.
  #
  # AND WHAT IT MUST NOT BECOME: no `check` on the backend servers. The server
  # autopauses when idle and wakes on any TCP connection, so a health probe
  # would mean the JVM never sleeps. See the header.

  default_backend mc_nodes

backend mc_nodes
  balance first
  # Tailnet addresses of every cluster node, stable-machine order (the three
  # desktops first, then the laptop fleet). Tailscale IPs don't churn; if a
  # node joins or leaves the cluster, update this list and re-run bootstrap.
  server zachd-ubuntu          100.121.136.39:25565
  server zachd-ubuntu-1        100.84.179.82:25565
  server zachd-ubuntu-2        100.118.242.89:25565
  server zachd-ubuntu-laptop   100.124.40.81:25565
  server zachd-ubuntu-laptop-1 100.122.194.1:25565
  server zachd-ubuntu-laptop-2 100.81.206.46:25565
  server zachd-ubuntu-laptop-3 100.74.215.87:25565
  server zachd-ubuntu-laptop-4 100.93.49.109:25565
  server zachd-ubuntu-laptop-5 100.116.117.82:25565
  server zachd-ubuntu-laptop-6 100.109.25.85:25565
