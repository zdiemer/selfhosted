# Helm stores the packaged chart inside its release Secret (hard 1MiB cap).
# The gateway and journal apps ship in the image, not the chart — keep all of
# both out (node_modules alone would be most of the budget).
gateway/
journal/
Dockerfile
build.sh
upgrade.sh
values.local.yaml
values.local.tpl.yaml
# Delegated profile secrets must stay out of packaged release charts too.
values.*.local.yaml
values.*.local.tpl.yaml
