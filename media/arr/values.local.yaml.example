# Copy to values.local.yaml and fill in. values.local.yaml is gitignored.
#
# PIA credentials are the p1234567 username + password from
# https://www.privateinternetaccess.com/account — the same pair the desktop
# apps use. gluetun does the OpenVPN dance with them; nothing else is needed
# for port forwarding.

pia:
  username: "p1234567"
  password: "xxxxxxxxxxxx"

# Sonarr's and Radarr's API keys (Settings → General → API Key in each app).
# The decluttarr watchdog runs in its own pod and calls their queue APIs, so it
# needs them handed to it; nothing else in this chart does.
decluttarr:
  sonarrApiKey: "0123456789abcdef0123456789abcdef"
  radarrApiKey: "0123456789abcdef0123456789abcdef"
